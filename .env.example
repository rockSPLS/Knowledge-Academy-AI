# Образец настроек генерации путешествий и поиска по материалам. Скопируйте файл в .env.local
# (в корне проекта) и впишите свои значения: .env.local не попадает в репозиторий.
# Генерации нужны AI_BASE_URL, AI_API_KEY, AI_MODEL и JOURNEY_SECRET; без любой из них сайт работает,
# но генерация недоступна. Без адреса или ключа поиск находит фрагменты только по словам и без ответа
# модели; без AI_MODEL — без ответа модели.

# Адрес API, совместимого с OpenAI (заканчивается обычно на /v1)
AI_BASE_URL=

# Ключ API у этого провайдера
AI_API_KEY=

# Название модели у этого провайдера
AI_MODEL=

# Модель эмбеддингов у того же провайдера (адрес и ключ — те же AI_BASE_URL и AI_API_KEY).
# Нужна поиску по материалам: вопрос сравнивается с фрагментами статей по смыслу. Без неё поиск
# находит фрагменты только по словам. Индекс фрагментов в репозитории (lib/search/search-index.json)
# посчитан моделью alibaba/qwen3-embedding-8b (название — как в Vercel AI Gateway): впишите её.
# Если у вашего провайдера модель называется иначе или вы берёте другую, сначала пересчитайте индекс
# командой npm run search:index (векторы разных моделей несравнимы), иначе поиск идёт только по словам
AI_EMBEDDING_MODEL=

# Необязательно. Уровень размышлений для «рассуждающих» моделей: low, medium или high.
# Такие модели перед ответом пишут скрытый черновик — он стоит токенов и времени и входит
# в лимит длины ответа. С low генерация быстрее и реже обрывается по лимиту.
# Оставьте пустым, если модель не рассуждающая: не все модели принимают этот параметр.
# Неподходящее значение провайдер отклонит, и генерация будет «недоступна» — причина в логе сервера
AI_REASONING_EFFORT=

# Секрет для шифрования путешествий (не короче 32 символов), любая случайная строка.
# Сгенерировать (в любом терминале, где есть Node):
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Без него генерация тоже недоступна. Смена секрета делает недействительными
# уже выданные путешествия — их нужно сгенерировать заново
JOURNEY_SECRET=
