# Образец настроек языковой модели. Скопируйте файл в .env.local (в корне проекта)
# и впишите свои значения: .env.local не попадает в репозиторий.
# Нужны все три настройки; без любой из них сайт работает, но генерация недоступна.

# Адрес API, совместимого с OpenAI (заканчивается обычно на /v1)
AI_BASE_URL=

# Ключ API у этого провайдера
AI_API_KEY=

# Название модели у этого провайдера
AI_MODEL=
