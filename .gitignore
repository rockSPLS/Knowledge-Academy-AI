# Подробнее об игнорировании файлов: https://help.github.com/articles/ignoring-files/

# зависимости
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# тесты
/coverage

# next.js
/.next/
/out/

# production-сборка
/build

# прочее
.DS_Store
*.pem

# отладка
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# файлы окружения: в репозиторий не попадают; исключение — образец без значений
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# claude code
/.claude/
